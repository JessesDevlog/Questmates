[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/ui/pet_corner.gd" id="1"]

[node name="PetCorner" type="MarginContainer"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
theme_override_constants/margin_left = 0
theme_override_constants/margin_top = 0
theme_override_constants/margin_right = 0
theme_override_constants/margin_bottom = 0
script = ExtResource("1")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="VBox"]
layout_mode = 2
theme_type_variation = &"title"
text = "Pet Corner"

[node name="ChildList" type="ItemList" parent="VBox"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_horizontal = 3

[node name="PetPreviewSlot" type="Control" parent="VBox"]
custom_minimum_size = Vector2(0, 160)
layout_mode = 2
size_flags_horizontal = 3

[node name="PetRoot" type="Node3D" parent="VBox/PetPreviewSlot"]
unique_name_in_owner = true

[node name="FeedButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Feed Pet (uses child coins)"

[node name="DressButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Dress Up"

[node name="StatusLabel" type="Label" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Select a child profile"
autowrap_mode = 3

[node name="BackButton" type="Button" parent="VBox"]
unique_name_in_owner = true
layout_mode = 2
text = "Close"
