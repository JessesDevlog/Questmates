# Copy to secrets.gd and fill in your Supabase project values.
# secrets.gd is gitignored — never commit real keys.

extends RefCounted
class_name SecretsConfig

const SUPABASE_URL := "https://YOUR_PROJECT_REF.supabase.co"

# Preferred: Dashboard → Settings → API Keys → "Publishable and secret API keys"
# Copy the default publishable key (starts with sb_publishable_).
const SUPABASE_PUBLISHABLE_KEY := "sb_publishable_YOUR_KEY_HERE"

# Legacy anon JWT still works until ~late 2026, but publishable keys are recommended.
# If you only have the legacy anon key, paste it into SUPABASE_PUBLISHABLE_KEY above.

static func get_api_key() -> String:
	return SUPABASE_PUBLISHABLE_KEY
